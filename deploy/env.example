# Ducalis — конфигурация окружения для VM.
# Копируйте в deploy/env и заполните: cp env.example env
# deploy.sh загружает этот файл перед запуском сервисов.

# ── PostgreSQL ─────────────────────────────────────────────────────
DATABASE_URL=postgres://ducalis:ducalis123@localhost:5432/ducalis?sslmode=disable

# ── Секреты (ОБЯЗАТЕЛЬНО сменить!) ─────────────────────────────────
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
ADMIN_JWT_SECRET=change-admin-openssl-rand-hex-32
INTERNAL_API_KEY=change-internal-openssl-rand-hex-32

# ── Адреса сервисов (обычно не менять) ─────────────────────────────
PUBLIC_BIND=:8080
ADMIN_BIND=:8082
INTERNAL_BIND=:8083

# ── Фронтенд ───────────────────────────────────────────────────────
# Директория со собранным SPA (web/dist). deploy.sh кладёт её в release.
WEB_DIST=./web

# ── Логи ───────────────────────────────────────────────────────────
LOG_LEVEL=info
