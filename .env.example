# Ducalis TG - Environment Variables

# PostgreSQL connection
DATABASE_URL=postgres://ducalis:ducalis123@localhost:5432/ducalis?sslmode=disable

# Redis connection
REDIS_URL=redis://localhost:6379/0

# Kafka brokers
KAFKA_BROKERS=localhost:9092

# Service bind addresses
BIND=:8080

# JWT secrets (CHANGE IN PRODUCTION)
JWT_SECRET=change-me-in-production
ADMIN_JWT_SECRET=change-admin-secret-in-production

# Internal API key for service-to-service auth
INTERNAL_API_KEY=change-internal-api-key-in-production

# Logging
LOG_LEVEL=info
